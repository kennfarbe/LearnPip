# Copy to deploy/.env.production; keep local and private.
# DNS A/AAAA records must point to the public VM.
LEARNPIP_DOMAIN=learn.example.org
# Required for deploy/compose.release.yaml; set to the downloaded release version.
LEARNPIP_VERSION=

# Optional integrations; their secrets live in deploy/secrets, not this file.
LEARNPIP_MAIL_HOST=
LEARNPIP_MAIL_PORT=587
LEARNPIP_MAIL_FROM=
LEARNPIP_MAIL_USERNAME=
LEARNPIP_OIDC_AUTHORITY=
LEARNPIP_OIDC_CLIENT_ID=
LEARNPIP_OIDC_POST_LOGIN_PATH=/

# Optional AI. Off by default; enable only configured modes after reviewing data routes.
LEARNPIP_AI_ALLOWED_MODES=off
LEARNPIP_AI_CLOUD_ENDPOINT=
LEARNPIP_AI_CLOUD_MODEL=
LEARNPIP_AI_LOCAL_ENDPOINT=
LEARNPIP_AI_LOCAL_MODEL=
LEARNPIP_AI_MAX_INPUT_BYTES=8192
LEARNPIP_AI_MAX_IMAGE_BYTES=2097152
LEARNPIP_AI_CLOUD_DAILY_QUOTA=10
LEARNPIP_AI_LOCAL_DAILY_QUOTA=50
LEARNPIP_AI_USER_DAILY_QUOTA=20
