# Copy to deploy/.env.production; keep local and private.
# DNS A/AAAA records must point to the public VM.
LEARNPIP_DOMAIN=learn.example.org

# Optional integrations; their secrets live in deploy/secrets, not this file.
LEARNPIP_MAIL_HOST=
LEARNPIP_MAIL_PORT=587
LEARNPIP_MAIL_FROM=
LEARNPIP_MAIL_USERNAME=
LEARNPIP_OIDC_AUTHORITY=
LEARNPIP_OIDC_CLIENT_ID=
LEARNPIP_OIDC_POST_LOGIN_PATH=/
