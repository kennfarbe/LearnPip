# Copy this file to deploy/.env for local Docker Compose use.
# scripts/dev-up.sh generates a random local password if this value is blank.
POSTGRES_DB=learnpip
POSTGRES_USER=learnpip
POSTGRES_PASSWORD=

# Optional identity integrations. Keep actual values in ignored deploy/.env.
LEARNPIP_EMAIL_CODE_KEY=
LEARNPIP_MAIL_HOST=
LEARNPIP_MAIL_PORT=587
LEARNPIP_MAIL_FROM=
LEARNPIP_MAIL_USERNAME=
LEARNPIP_MAIL_PASSWORD=
LEARNPIP_OIDC_AUTHORITY=
LEARNPIP_OIDC_CLIENT_ID=
LEARNPIP_OIDC_CLIENT_SECRET=
LEARNPIP_OIDC_POST_LOGIN_PATH=/
LEARNPIP_PUBLIC_ORIGIN=
