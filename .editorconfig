root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_style = space
indent_size = 4
dotnet_sort_system_directives_first = true
dotnet_style_qualification_for_field = true:warning
dotnet_style_qualification_for_property = true:warning
dotnet_style_qualification_for_method = true:warning
dotnet_style_qualification_for_event = true:warning
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

[*.{ts,tsx,js,jsx,json,yml,yaml,css,html}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false


# Existing API analyzer debt (follow-up cleanup). New warnings remain errors.
[backend/src/LearnPip.Api/*.cs]
dotnet_diagnostic.S1118.severity = none
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.S1075.severity = none
dotnet_diagnostic.S6966.severity = none

[backend/src/LearnPip.Api/**/*.cs]
dotnet_diagnostic.S1118.severity = none
dotnet_diagnostic.S3358.severity = none
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.S6966.severity = none
dotnet_diagnostic.S1075.severity = none
dotnet_diagnostic.S1871.severity = none
dotnet_diagnostic.S3267.severity = none
dotnet_diagnostic.CA1859.severity = none
dotnet_diagnostic.S8969.severity = none
dotnet_diagnostic.S1125.severity = none
dotnet_diagnostic.S6610.severity = none
dotnet_diagnostic.CA1866.severity = none
dotnet_diagnostic.S6444.severity = none

# Test names intentionally describe behavior using underscores; tests also retain
# a few fixture-specific analyzer exceptions without relaxing production code.
[tests/LearnPip.Data.Tests/*.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.S6966.severity = none
