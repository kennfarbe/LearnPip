root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_style = space
indent_size = 4
dotnet_sort_system_directives_first = true
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

[*.{ts,tsx,js,jsx,json,yml,yaml,css,html}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# Legacy formatting baseline: the repository uses file-scoped namespaces,
# top-level using directives, compact declarations and no mandatory this. prefix.
# Keep SDK, Sonar and remaining StyleCop diagnostics active; warnings fail the build.
[*.cs]
dotnet_diagnostic.SA0001.severity = none
dotnet_diagnostic.SA1101.severity = none
dotnet_diagnostic.SA1116.severity = none
dotnet_diagnostic.SA1117.severity = none
dotnet_diagnostic.SA1118.severity = none
dotnet_diagnostic.SA1122.severity = none
dotnet_diagnostic.SA1200.severity = none
dotnet_diagnostic.SA1402.severity = none
dotnet_diagnostic.SA1408.severity = none
dotnet_diagnostic.SA1413.severity = none
dotnet_diagnostic.SA1500.severity = none
dotnet_diagnostic.SA1503.severity = none
dotnet_diagnostic.SA1513.severity = none
dotnet_diagnostic.SA1515.severity = none
dotnet_diagnostic.SA1516.severity = none
dotnet_diagnostic.SA1633.severity = none
dotnet_diagnostic.SA1649.severity = none
dotnet_diagnostic.SA1407.severity = none
dotnet_diagnostic.SA1107.severity = none
dotnet_diagnostic.SA1520.severity = none
dotnet_diagnostic.SA1501.severity = none
dotnet_diagnostic.SA1519.severity = none
dotnet_diagnostic.SA1204.severity = none
dotnet_diagnostic.SA1202.severity = none
dotnet_diagnostic.SA1201.severity = none

# EF migrations are generated snapshots and should not be hand-refactored.
[**/Migrations/*.cs]
generated_code = true
dotnet_diagnostic.CA1861.severity = none

# Existing API analyzer debt (follow-up cleanup). New warnings remain errors.
[backend/src/LearnPip.Api/*.cs]
dotnet_diagnostic.S1118.severity = none
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.S1075.severity = none
dotnet_diagnostic.S6966.severity = none

[backend/src/LearnPip.Api/**/*.cs]
dotnet_diagnostic.S1118.severity = none
dotnet_diagnostic.S3358.severity = none
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.S6966.severity = none
dotnet_diagnostic.S1481.severity = none
dotnet_diagnostic.S6580.severity = none
