{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kennfarbe/LearnPip/blob/main/schemas/catalog/0.1.0/questions.schema.json",
  "title": "LearnPip-Katalogfragen (Entwurf 0.1.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "questions"
  ],
  "$defs": {
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "holder",
        "attribution"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "license_url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "holder": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "attribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "original",
            "adapted",
            "verbatim"
          ]
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "source_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "modification_note": {
          "type": "string",
          "maxLength": 2048
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "adapted",
                  "verbatim"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "source_url",
              "source_revision"
            ]
          }
        }
      ]
    }
  },
  "properties": {
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "language",
          "prompt",
          "answers",
          "correct_answer_ids",
          "explanation",
          "topics",
          "difficulty",
          "license",
          "provenance",
          "media"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "answers": {
            "type": "array",
            "minItems": 2,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "text"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 10000
                }
              }
            }
          },
          "correct_answer_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "explanation": {
            "type": "string",
            "maxLength": 20000
          },
          "topics": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "difficulty": {
            "enum": [
              "unknown",
              "easy",
              "medium",
              "hard"
            ]
          },
          "age_band": {
            "type": "string",
            "maxLength": 80
          },
          "license": {
            "$ref": "#/$defs/license"
          },
          "provenance": {
            "$ref": "#/$defs/provenance"
          },
          "media": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "alt",
                "license",
                "provenance"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^media/[A-Za-z0-9._/-]+$",
                  "maxLength": 256
                },
                "alt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "license": {
                  "$ref": "#/$defs/license"
                },
                "provenance": {
                  "$ref": "#/$defs/provenance"
                }
              }
            }
          }
        }
      }
    }
  }
}
