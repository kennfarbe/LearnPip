{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kennfarbe/LearnPip/blob/main/schemas/catalog/0.1.0/manifest.schema.json",
  "title": "LearnPip-Katalogmanifest (Entwurf 0.1.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_id",
    "schema_version",
    "package_id",
    "catalog_version",
    "source_revision",
    "title",
    "description",
    "language",
    "publisher",
    "created_at",
    "license",
    "files"
  ],
  "properties": {
    "format_id": {
      "const": "org.learnpip.catalog.zip"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "package_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "catalog_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "exporter_app_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "description": {
      "type": "string",
      "maxLength": 2048
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "license": {
      "$ref": "questions.schema.json#/$defs/license"
    },
    "files": {
      "type": "array",
      "minItems": 4,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(questions.json|LICENSES.md|NOTICE|ATTRIBUTION|media/[A-Za-z0-9._/-]+)$",
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 104857600
          },
          "media_type": {
            "type": "string",
            "maxLength": 128
          }
        }
      }
    }
  }
}
