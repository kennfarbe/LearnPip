# Entity Framework Core regenerates migrations and the model snapshot.
# Apply the parent EditorConfig everywhere else. Generated files retain spaces,
# but hand-written member-qualification formatting is not enforced here.
root = false

[*.cs]
generated_code = true
indent_style = space
indent_size = 4

# Generated formatting can differ from the hand-written this. convention.
dotnet_diagnostic.SA1101.severity = none
dotnet_diagnostic.IDE0009.severity = none
